---
// Import Components
import Image from 'astro/components/Image.astro';
import { urlForImage } from '../../src/sanity/lib/image';

const { slides } = Astro.props;

// // DEBUG: Log de volledige slides data
// if (import.meta.env.DEV) {
//   console.log('🎠 Carousel received slides:', JSON.stringify(slides, null, 2));
//   console.log('🎠 Slides count:', slides?.length || 0);

//   // Log elke slide individueel
//   slides?.forEach((slide: any, index: number) => {
//     console.log(`🎠 Slide ${index}:`, {
//       _type: slide._type,
//       title: slide.title,
//       subtitle: slide.subtitle,
//       image: slide.image,
//       link: slide.link,
//       videoUrl: slide.videoUrl
//     });
//   });
// }

// Process Sanity slides
const processedSlides = slides.map((slide: any) => {
  if (import.meta.env.DEV) {
    // console.log(`🎠 Processing slide "${slide.title}":`, {
    //   hasImage: !!slide.image,
    //   hasAsset: !!slide.image?.asset,
    //   imageRef: slide.image?.asset?._ref,
    //   hasKey: !!slide._key,
    //   link: slide.link
    // });
  }

  // Sanity data structure - build URL based on link type
  const linkObj = slide.link;
  let updatedUrl = '';
  let updatedTitle = slide.title || '';
  const updatedTarget = '_self'; // Default to same tab

  if (linkObj) {
    if (linkObj.linkType === 'external' && linkObj.url) {
      // External link
      updatedUrl = linkObj.url;
    } else if (linkObj.linkType === 'internal' && linkObj.internalLink) {
      // Internal link - check if it's a project (work) or page
      const internalLink = linkObj.internalLink;
      const slug = internalLink.slug?.current || internalLink.slug;

      if (slug) {
        if (internalLink._type === 'work') {
          // Project link - use /project/ prefix
          updatedUrl = `/project/${slug}`;
        } else if (internalLink._type === 'page') {
          // Page link - use direct slug
          updatedUrl = `/${slug}`;
        } else {
          // Fallback - try to use slug directly
          updatedUrl = `/${slug}`;
        }
      }
    } else if (linkObj.internalLink) {
      // Fallback: if linkType is not set but internalLink exists
      const internalLink = linkObj.internalLink;
      const slug = internalLink.slug?.current || internalLink.slug;

      if (slug) {
        if (internalLink._type === 'work') {
          updatedUrl = `/project/${slug}`;
        } else {
          updatedUrl = `/${slug}`;
        }
      }
    }
  }

  return {
    ...slide,
    link: updatedUrl
      ? {
          title: updatedTitle,
          url: updatedUrl,
          target: updatedTarget,
        }
      : null,
  };
});

// Image dimensions for carousel
const imageWidth = 1920;
const imageHeight = Math.round((imageWidth * 9) / 16); // 16:9 aspect ratio

const backgroundSlides = processedSlides.map((slide: any) => {
  // Sanity image handling
  let imageUrl = '';
  if (slide.image?.asset) {
    try {
      imageUrl = urlForImage(slide.image)?.width(imageWidth).url() || '';
    } catch (error) {
      if (import.meta.env.DEV) {
        console.warn('⚠️ Failed to generate image URL:', error);
      }
      // Fallback to direct URL if available
      imageUrl = slide.image?.asset?.url || '';
    }
  }

  // DEBUG: Log image details
  if (import.meta.env.DEV) {
    // console.log('🖼️ Sanity slide image processing:', {
    //   slideTitle: slide.title,
    //   hasImage: !!slide.image,
    //   hasAsset: !!slide.image?.asset,
    //   assetRef: slide.image?.asset?._ref,
    //   alt: slide.image?.alt,
    //   generatedUrl: imageUrl,
    //   directUrl: slide.image?.asset?.url
    // });
  }

  return {
    imgsrc: imageUrl,
    imgalt: slide.image?.alt || slide.title || '',
    vidsrc: slide.videoUrl || '',
  };
});

const foregroundSlides = processedSlides.map((slide: any) => {
  return {
    title: slide.title || '',
    subtitle: slide.subtitle || '',
    link: slide.link,
  };
});
---

<section class="carousel-gallery full">
  <div class="carousels">
    <!-- Foreground Carousel -->
    <div class="carousel carousel-foreground swiper">
      <div role="list" class="swiper-wrapper">
        {
          foregroundSlides &&
            foregroundSlides.map(
              (
                slide: any, // slide
              ) => (
                <div role="listitem" class="swiper-slide">
                  <div class="slide-layout">
                    {slide.link ? (
                      <a
                        class="slide-text"
                        href={slide.link.url}
                        target={slide.link.target}
                        aria-label={`${slide.link.title || slide.title}`}
                      >
                        <h3 class="opacity-80">{slide.subtitle}</h3>
                        <h1>{slide.title}</h1>
                      </a>
                    ) : (
                      <div class="slide-text">
                        <h3 class="opacity-80">{slide.subtitle}</h3>
                        <h1>{slide.title}</h1>
                      </div>
                    )}
                  </div>
                </div>
              ),
            )
        }
      </div>
    </div>
    <!-- Gradient over background, onder de tekst -->
    <div class="carousel-scrim" aria-hidden="true"></div>
    <!-- Carousel Controls -->
    <div class="controls swiper-controls align-middle">
      <div class="controls-wrapper align-middle">
        <div class="control-indicator swiper-indicator">
          <p class="swiper-counter">
            <span class="swiper-number-current">00</span> &mdash;
            <span class="swiper-number-total">00</span>
          </p>
        </div>
        <a
          href="#"
          class="control-button swiper-button-prev"
          aria-label="Show previous slide"
        >
          <div class="control-button_icon is_reversed">
            <svg
              width="24px"
              height="24px"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              ><path
                d="M5 12h14m0 0-7-7m7 7-7 7"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path></svg
            >
          </div>
        </a>
        <a
          href="#"
          class="control-button swiper-button-next"
          aria-label="Show next slide"
        >
          <div class="control-button_icon">
            <svg
              width="24px"
              height="24px"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              ><path
                d="M5 12h14m0 0-7-7m7 7-7 7"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path></svg
            >
          </div>
        </a>
      </div>
    </div>
    <!-- Darkens as the carousel leaves the viewport -->
    <div class="carousel-veil" aria-hidden="true"></div>
    <!-- Background Carousel -->
    <div class="carousel carousel-background swiper">
      <!-- Slides -->
      <div role="list" class="swiper-wrapper">
        {
          backgroundSlides &&
            backgroundSlides.map((slide: any, index: number) => (
              <div role="listitem" class="swiper-slide">
                {slide.vidsrc && (
                  <div class="video-wrapper">
                    <div class="video-overlay">
                      <video
                        class="video"
                        playsinline=""
                        loop=""
                        muted=""
                        autoplay=""
                      >
                        <source src={slide.vidsrc} />
                      </video>
                    </div>
                  </div>
                )}
                {slide.imgsrc && (
                  <Image
                    src={slide.imgsrc}
                    width={imageWidth}
                    height={imageHeight}
                    widths={[540, 960, 1440, 1920]}
                    sizes={`(max-width: 360px) 540px, (max-width: 720px) 960px, (max-width: 1600px) 1440px, 1920px`}
                    format="avif"
                    alt={slide.imgalt || ''}
                    loading={index === 0 ? 'eager' : 'lazy'}
                  />
                )}
              </div>
            ))
        }
      </div>
    </div>
  </div>
</section>

<script src="../lib/swiper.js"></script>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { prefersReducedMotion } from '../lib/gsap-inview';

  gsap.registerPlugin(ScrollTrigger);

  let ctx: gsap.Context | undefined;
  let initToken = 0;

  function cleanup() {
    ctx?.revert();
    ctx = undefined;
  }

  function initCarouselVeil() {
    const token = ++initToken;
    cleanup();

    const galleries = document.querySelectorAll<HTMLElement>(
      '.carousel-gallery',
    );
    if (!galleries.length) return;

    ctx = gsap.context(() => {
      galleries.forEach((gallery) => {
        if (!document.contains(gallery)) return;

        const veil = gallery.querySelector<HTMLElement>('.carousel-veil');
        if (!veil) return;

        gsap.fromTo(
          veil,
          { opacity: 0 },
          {
            opacity: 0.5,
            ease: 'none',
            scrollTrigger: {
              trigger: gallery,
              start: 'top top',
              end: 'bottom 30%',
              scrub: prefersReducedMotion() ? true : 0.45,
              invalidateOnRefresh: true,
            },
          },
        );
      });
    });

    if (token !== initToken) {
      cleanup();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCarouselVeil);
  } else {
    initCarouselVeil();
  }

  document.addEventListener('astro:page-load', initCarouselVeil);
  document.addEventListener('astro:before-swap', () => {
    initToken += 1;
    cleanup();
  });
</script>

<style>
  /* * > * {
    border: 1px solid red;
   } */
  /* Algemene instellingen voor de carousel gallery */
  .carousel-gallery {
    margin-block: 0;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100dvh;
    position: relative;
    overflow: hidden;
  }

  .carousels {
    padding: 0;
    margin: 0;
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  /* Achtergrond carousel instellingen */
  .carousel-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1; /* Achtergrond */
  }

  .carousel-background .swiper-slide {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden; /* Zorgt ervoor dat de inhoud in de viewport past */
  }

  .carousel-background .video-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2; /* Zorgt ervoor dat de video boven de afbeelding ligt */
  }

  .carousel-background .video,
  .carousel-background video {
    width: 100%;
    height: 100%;
    object-fit: cover; /* Past de video aan om de hele slide te bedekken */
  }

  .carousel-background .poster,
  .carousel-background img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* Past de afbeelding aan om de hele slide te bedekken */
    z-index: 1; /* Zorgt ervoor dat de afbeelding onder de video ligt */
  }

  /* Gradient tussen background en tekst/controls */
  .carousel-scrim {
    position: absolute;
    inset: auto 0 0 0;
    height: min(45%, 18rem);
    z-index: 2;
    pointer-events: none;
    background-image: linear-gradient(rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.6));
  }

  /* Scroll-linked veil: carousel goes dark when 30% remains in view */
  .carousel-veil {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    background: rgb(12, 12, 12);
    opacity: 0;
    will-change: opacity;
  }

  /* Voorgrond carousel: tekst boven de gradient */
  .carousel-foreground {
    position: relative;
    width: 100%;
    height: 100%;
    z-index: 3;
    display: flex;
    justify-content: flex-start;
    align-items: flex-end;
    pointer-events: none;
  }
  .carousel-foreground .swiper-wrapper {
    width: 100%;
    height: 100%;
  }
  .carousel-foreground .swiper-slide {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: stretch;
    color: white;
    pointer-events: none;
    min-height: 100%;
    min-width: 100%;
    padding: 0;
    margin: 0;
  }

  /* Nested breakout-grid: hergebruikt --full/--page/… van .page-layout */
  .slide-layout {
    display: grid;
    grid-template-columns:
      [full-start] var(--full) [page-start] var(--page)
      [feature-start] var(--feature) [popout-start] var(--popout)
      [content-start] var(--content) [inset-content-start] var(--inset-content)
      [inset-content-end] var(--content) [content-end] var(--popout)
      [popout-end] var(--feature) [feature-end] var(--page) [page-end]
      var(--full) [full-end];
    width: 100%;
    height: 100%;
    align-content: end;
    padding-block: var(--space-s-xl);
  }

  .carousel-foreground .swiper-slide a {
    pointer-events: auto;
  }

  /* Controls bovenop, zonder gradient; alleen knoppen vangen clicks */
  .controls {
    position: absolute;
    top: auto;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 4;
    display: grid;
    grid-template-columns:
      [full-start] var(--full) [page-start] var(--page)
      [feature-start] var(--feature) [popout-start] var(--popout)
      [content-start] var(--content) [inset-content-start] var(--inset-content)
      [inset-content-end] var(--content) [content-end] var(--popout)
      [popout-end] var(--feature) [feature-end] var(--page) [page-end]
      var(--full) [full-end];
    align-items: end;
    padding-block: var(--space-s-xl);
    pointer-events: none;
    background: none;
  }

  .controls-wrapper {
    grid-column: page;
    display: flex;
    flex-wrap: wrap;
    flex: 0 auto;
    justify-content: flex-end;
    align-items: center;
    gap: 0.5rem;
    pointer-events: none;
  }

  .control-button,
  .control-indicator {
    pointer-events: auto;
  }

  .control-button {
    backdrop-filter: blur(30px);
    color: #fff;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    flex: none;
    justify-content: center;
    align-items: center;
    width: 2.5rem;
    height: 2.5rem;
    transition:
      background-color 0.2s,
      color 0.2s;
    display: flex;
  }
  .control-button:hover {
    color: #000;
    background-color: #fff;
  }
  .control-button_icon {
    flex: none;
    align-self: center;
  }

  .control-button_icon svg {
    transform: scale(0.75);
  }

  .control-indicator {
    color: white;
  }
  .is_reversed {
    transform: rotate(-180deg);
  }

  .video-wrapper {
    width: 100%;
    height: 100%;
  }
  .video-overlay {
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
  }
  .video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slide-text {
    grid-column: page;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: var(--space-3xs);
    max-width: min(70ch, 100%);
    color: #fff;
  }
  h1 {
    font-size: var(--fs-0);
    font-weight: 400;
    /* letter-spacing: -0.035em; */
    text-wrap: balance;
    line-height: 100%;
    color: #fff;
  }

  h3 {
    font-size: var(--fs--1);

    font-weight: 500;
    line-height: 125%;
  }
  a {
    text-decoration: none !important;
  }

  a:hover {
    text-decoration: none !important;
  }
</style>
