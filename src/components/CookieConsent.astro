<script>
  import { cookieConsentConfig } from '../lib/CookieConsentConfig';
  import { iframeManagerConfig } from '../lib/IframeManagerConfig';

  declare global {
    interface Window {
      CookieConsent: any;
      iframemanager: any;
      __iframeManagerConfig?: any;
      __cookieConsentConfig?: any;
      __initConsentManagers?: () => void;
    }
  }

  const initConsentManagers = () => {
    try {
      if (!(window as any).__ifmInit) {
        const im = window.iframemanager();
        im.run(iframeManagerConfig);
        (window as any).__ifmInit = true;
      }
    } catch (e) {}

    try {
      if (!(window as any).__ccInit) {
        window.CookieConsent.run(cookieConsentConfig);
        (window as any).__ccInit = true;
      }
    } catch (e) {}
  };

  (window as any).__iframeManagerConfig = iframeManagerConfig;
  (window as any).__cookieConsentConfig = cookieConsentConfig;
  (window as any).__initConsentManagers = initConsentManagers;

  window.addEventListener('load', initConsentManagers);
  document.addEventListener('astro:page-load', initConsentManagers);
</script>

