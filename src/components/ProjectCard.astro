---
// Import Components
import { Image, getImage } from 'astro:assets';
import TagGroup from '../components/TagGroup.astro';
import { slugify } from '../lib/utils.js';
import { urlForImage } from '../../src/sanity/lib/image';

// Type Definitions
type TaxonomyItem = {
  title: string;
  slug?: string;
};

type ProjectProps = {
  clientname?: string;
  title?: string;
  imgsrc?: string;
  imgalt?: string;
  vidsrc?: string;
  link?: string;
  size?: string;
  services?: TaxonomyItem[];
  industry?: TaxonomyItem | null;
  filterBasePath?: string;
  fitCards?: boolean;
  aspectRatio?: string;
  // Sanity specific props
  thumbnail?: any;
  client?: any;
};

// Extract props
const {
  clientname,
  title,
  imgsrc,
  imgalt,
  vidsrc,
  link,
  size,
  services,
  industry,
  filterBasePath,
  fitCards,
  aspectRatio = '16:9',
  thumbnail,
  client,
} = Astro.props as ProjectProps;

// Normalize values - Sanity data takes precedence over direct props
// This prevents duplication by using Sanity structure when available
const clientName = client?.title || clientname || '';
const projectTitle = title || '';
const projectLink = link || '#';
const projectServices = Array.isArray(services) ? services : [];
const projectIndustry =
  industry && (industry.title || industry.slug) ? industry : null;
const projectSize = thumbnail?.size || size;
const projectFitCards = fitCards ?? false;
const projectAspectRatio = thumbnail?.aspectRatio || aspectRatio;

function taxonomySlug(item: TaxonomyItem): string {
  return item.slug || slugify(item.title || '');
}

function filterLink(
  param: 'industry' | 'service',
  value: string,
): string | undefined {
  if (!filterBasePath || !value) return undefined;
  const base = filterBasePath.endsWith('/')
    ? filterBasePath
    : `${filterBasePath}/`;
  return `${base}?${param}=${encodeURIComponent(value)}`;
}

const tagItems = [
  ...(projectIndustry?.title
    ? [
        {
          title: projectIndustry.title,
          variant: 'filled' as const,
          link: filterLink('industry', taxonomySlug(projectIndustry)),
        },
      ]
    : []),
  ...projectServices
    .filter((service) => service?.title)
    .map((service) => ({
      title: service.title,
      variant: 'outline' as const,
      link: filterLink('service', taxonomySlug(service)),
    })),
];

// Calculate height based on aspect ratio
function getHeightFromAspectRatio(width: number, aspectRatio: string): number {
  const [w, h] = aspectRatio.split(':').map(Number);
  if (w && h) {
    return Math.round((width * h) / w);
  }
  // Default to 16:9 if invalid
  return Math.round((width * 9) / 16);
}

// Generate image URL - prefer Sanity thumbnail (more flexible), fallback to pre-generated imgsrc
// Only generate from Sanity if imgsrc wasn't already provided
let imageSrc = imgsrc || '';
let imageAlt = imgalt || projectTitle || '';

if (!imageSrc && thumbnail?.image?.asset) {
  try {
    const width = 1920;
    const aspectRatio = projectAspectRatio || '16:9';
    const height = getHeightFromAspectRatio(width, aspectRatio);

    const sanityImageUrl = urlForImage(thumbnail.image)
      ?.width(width)
      .height(height)
      .url();
    if (sanityImageUrl) {
      imageSrc = sanityImageUrl;
    }
  } catch (error) {
    if (import.meta.env.DEV) {
      console.warn('⚠️ Failed to generate Sanity image URL:', error);
    }
  }
}

// Alt text from thumbnail takes precedence if available
if (thumbnail?.alt) {
  imageAlt = thumbnail.alt;
}

// Video source - check if useVideo is enabled
// Only use video if useVideo is true AND video URL is provided
const useVideo = thumbnail?.useVideo === true;
const videoSrc =
  useVideo && thumbnail?.video ? thumbnail.video : vidsrc || null;

// Generate poster image for video if needed
// Use thumbnail image as poster when useVideo is enabled
const posterImageSrc =
  useVideo && thumbnail?.image?.asset
    ? (() => {
        try {
          const width = 1280;
          const aspectRatio = projectAspectRatio || '16:9';
          const height = getHeightFromAspectRatio(width, aspectRatio);
          return (
            urlForImage(thumbnail.image)?.width(width).height(height).url() ||
            imageSrc
          );
        } catch (error) {
          return imageSrc;
        }
      })()
    : imageSrc;

const posterImage =
  videoSrc && posterImageSrc
    ? await getImage({
        src: posterImageSrc,
        width: 1280,
        height: getHeightFromAspectRatio(1280, projectAspectRatio),
        widths: [540, 960, 1440, 1920],
        sizes:
          '(max-width: 360px) 540px, (max-width: 720px) 960px, (max-width: 1600px) 1440px, 1920px',
        alt: imageAlt,
        title: projectTitle,
        format: 'webp',
      })
    : null;

let cardClasses = '';
if (!projectFitCards) {
  switch (projectSize) {
    case 'small':
      cardClasses = 'md:col-span-1 lg:col-span-4';
      break;
    case 'large':
      cardClasses = 'md:col-span-2 lg:col-span-8';
      break;
    case 'full':
      cardClasses = 'md:col-span-2 lg:col-span-12';
      break;
    default:
      cardClasses = 'md:col-span-2 lg:col-span-6';
  }
} else {
  cardClasses = 'md:col-span-1 lg:col-span-2';
}

// Taxonomy slugs for filtering
const serviceTitles =
  projectServices.map((service) => taxonomySlug(service)).join(' ') || '';
const industrySlug = projectIndustry ? taxonomySlug(projectIndustry) : '';

// Aspect ratio CSS class
const aspectRatioClass = `aspect-${projectAspectRatio.replace(':', '-')}`;
---

<div
  class={`project-card ${cardClasses}`}
  data-services={serviceTitles}
  data-industry={industrySlug}
  data-reveal-children=".project-media"
  style="--reveal-duration: 0.9s; --reveal-distance: 3rem; --reveal-delay: 200ms;"
>
  <div class={`overflow-hidden project-media ${aspectRatioClass}`}>
    {
      videoSrc ? (
        <div class="project-video">
          <video
            preload="metadata"
            tabindex="-1"
            disablepictureinpicture
            playsinline
            loop
            title={projectTitle}
            src={videoSrc}
            poster={posterImage?.src || imageSrc || undefined}
            autoplay={true}
            muted
          />
        </div>
      ) : (
        imageSrc && (
          <div class="project-image">
            <Image
              src={imageSrc}
              width={1920}
              height={getHeightFromAspectRatio(1920, projectAspectRatio)}
              widths={[540, 960, 1440, 1920]}
              sizes="(max-width: 360px) 540px, (max-width: 720px) 960px, (max-width: 1600px) 1440px, 1920px"
              format="avif"
              alt={imageAlt}
              title={projectTitle}
              loading="lazy"
            />
          </div>
        )
      )
    }
  </div>

  <div class="project-meta">
    {
      clientName && (
        <h3 class="project-client font-medium opacity-80">{clientName}</h3>
      )
    }

    {
      projectTitle && (
        <a href={projectLink} class="project-card-link">
          <h2 class="project-title leading-4">{projectTitle}</h2>
        </a>
      )
    }

    {tagItems.length > 0 && <TagGroup tags={tagItems} />}
  </div>
</div>

<style is:global>
  /* Position context for the link's pseudo-element */
  .project-card {
    position: relative;
    color: var(--font-color);
  }

  /* Link styling */
  .project-card-link {
    text-decoration: none;
    color: inherit;
  }

  /* Expand hitbox of link over whole card using pseudo-element */
  /* Positioned relative to .project-card (nearest positioned ancestor) */
  /* Following accessibility best practices: link only the heading text semantically,
       but extend the clickable area visually over the entire card */
  .project-card-link::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* Ensure nested interactive elements (like buttons) stay above the pseudo-element */
  .project-card button,
  .project-card a:not(.project-card-link) {
    position: relative;
    z-index: 20;
  }

  .project-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3xs);
    padding-top: 1.5rem;
  }

  .project-client {
    font-size: var(--fs--1);
    font-weight: 500;
    line-height: 125%;
    margin: 0;
  }

  .project-title {
    font-size: var(--fs-2);
    letter-spacing: -0.0125em;
    line-height: 100%;
    font-weight: 400;
    margin: 0;
    padding: 0;
    position: relative;
    text-decoration: none;
  }

  /* Aspect ratio classes */
  .aspect-16-9 {
    aspect-ratio: 16 / 9;
  }
  .aspect-5-4 {
    aspect-ratio: 5 / 4;
  }
  .aspect-4-3 {
    aspect-ratio: 4 / 3;
  }
  .aspect-3-2 {
    aspect-ratio: 3 / 2;
  }
  .aspect-1-1 {
    aspect-ratio: 1 / 1;
  }
  .aspect-2-3 {
    aspect-ratio: 2 / 3;
  }
  .aspect-3-4 {
    aspect-ratio: 3 / 4;
  }
  .aspect-4-5 {
    aspect-ratio: 4 / 5;
  }
  .aspect-9-16 {
    aspect-ratio: 9 / 16;
  }

  /* Ensure media content fills the aspect ratio container */
  .project-media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
  }

  .project-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0);
    pointer-events: none;
    transition: background 0.4s var(--easing-easeInOutExpo);
  }

  @media (hover: hover) {
    .project-card:hover .project-media::after {
      background: rgb(0 0 0 / 0.28);
    }
  }
  .project-media img,
  .project-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Ensure video container fills the aspect ratio */
  .project-image,
  .project-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
