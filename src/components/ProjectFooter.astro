---
import { PortableText } from 'astro-portabletext';
import TagGroup from './TagGroup.astro';

interface Props {
  info?: any[];
  industry?: {
    _id?: string;
    title?: string;
    slug?: string;
  } | null;
  services?: Array<{
    _id?: string;
    title?: string;
    slug?: string;
  }>;
  credits?: any[];
}

const { info, industry, services, credits } = Astro.props;

const components = {
  types: {},
  marks: {},
  block: {},
  list: {},
  listItem: {},
};

const hasCredits = Boolean(credits && credits.length > 0);
const hasMiddleColumn =
  Boolean(industry?.title) || Boolean(services && services.length > 0);

const serviceTags = (services || [])
  .filter((service) => service?.title)
  .map((service) => ({
    title: service.title,
    variant: 'outline' as const,
  }));
---

<section class="project-footer page">
  <div class:list={['project-footer-content', { 'has-credits': hasCredits }]}>
    <div class="project-footer-column project-footer-info">
      <h4 class="title">Info</h4>
      {
        info && info.length > 0 ? (
          <div class="project-footer-text">
            <PortableText value={info} components={components} />
          </div>
        ) : (
          <div class="project-footer-text" />
        )
      }
    </div>

    <div class="project-footer-column project-footer-taxonomies">
      {
        industry?.title && (
          <div class="project-footer-taxonomy">
            <h4 class="title">Industry</h4>
            <p class="project-footer-taxonomy-value">{industry.title}</p>
          </div>
        )
      }

      {
        serviceTags.length > 0 && (
          <div class="project-footer-taxonomy">
            <h4 class="title">Services</h4>
            <TagGroup tags={serviceTags} />
          </div>
        )
      }

      {!hasMiddleColumn && <div class="project-footer-taxonomy" />}
    </div>

    {
      hasCredits && (
        <div class="project-footer-column project-footer-credits">
          <h4 class="title">Credits</h4>
          <div class="project-footer-text">
            <PortableText value={credits} components={components} />
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .project-footer {
    color: var(--black);
  }

  .project-footer-content {
    display: grid;
    grid-template-columns: repeat(16, 1fr);
    gap: var(--space-xl);
  }

  .project-footer-info {
    grid-column: 4 / 10;
  }

  .project-footer-taxonomies {
    grid-column: 10 / 13;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .project-footer-credits {
    grid-column: 13 / 17;
  }

  .project-footer-content:not(.has-credits) .project-footer-taxonomies {
    grid-column: 10 / 17;
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .project-footer-info {
      grid-column: 1 / 9;
    }

    .project-footer-taxonomies {
      grid-column: 9 / 13;
    }

    .project-footer-credits {
      grid-column: 13 / 17;
    }

    .project-footer-content:not(.has-credits) .project-footer-taxonomies {
      grid-column: 9 / 17;
    }
  }

  @media (max-width: 767px) {
    .project-footer-content {
      grid-template-columns: 1fr;
    }

    .project-footer-info,
    .project-footer-taxonomies,
    .project-footer-credits {
      grid-column: 1;
    }
  }

  .project-footer-column .title {
    opacity: 0.6;
    font-size: var(--fs--1);
    font-weight: 600;
    line-height: 1;
    margin-block: 1rem;
  }

  .project-footer-taxonomy .title {
    margin-top: 0;
  }

  .project-footer-taxonomy-value {
    margin: 0;
    font-size: var(--fs--2);
    line-height: 133%;
  }

  .project-footer-text {
    font-size: var(--fs--1);
    line-height: 160%;
    letter-spacing: -0.0125rem;
    text-wrap: pretty;
  }

  :global(.project-footer-text p:first-child) {
    font-size: var(--fs-0);
    font-weight: 600;
  }

  :global(.project-footer-text p) {
    margin-bottom: 1em;
  }

  .project-footer-credits :global(.project-footer-text ul),
  .project-footer-credits :global(.project-footer-text ol) {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
    font-size: var(--fs--2);
    line-height: 100%;
  }

  .project-footer-credits :global(.project-footer-text ul li),
  .project-footer-credits :global(.project-footer-text ol li) {
    margin-bottom: 0.5em;
  }
</style>
