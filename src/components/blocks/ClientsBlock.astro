---
// Import Components & Scripts

// Define Types
interface Props{
  title: string;
  clients: any;
}

// Define Vars
const { title, clients } = Astro.props;

const sortedClients = Array.isArray(clients)
  ? [...clients]
      .filter((client: any) => client?.title)
      .sort((a: any, b: any) =>
        String(a.title).localeCompare(String(b.title), undefined, {
          sensitivity: 'base',
        }),
      )
  : [];
---

<!-- ClientsBlock -->
<div class:list={['clientsblock', 'page']}>
  {title && <h2 class="clientsblock-title">{title}</h2>}

  <div class="client-list">
    {
      sortedClients.map((client: any) => (
        <h4 class="client">{client.title}</h4>
      ))
    }
  </div>
</div>

<style>
.clientsblock-title {
  font-size: var(--fs-5);
  line-height: 112.5%;
  margin-bottom: var(--space-xl);
  font-weight: 500;
}

.client-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5lh 0;
}

.client {
  font-size: var(--fs-3);
  white-space: nowrap;
}

.client::after {
  content: ", \00a0";
}

.client:last-child::after {
  content: ".";
}
</style>