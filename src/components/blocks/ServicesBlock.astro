---
import { PortableText } from 'astro-portabletext';

interface Props {
  title: string;
  services: Array<{
    _id: string;
    title: string;
    content?: any[];
  }>;
  layout?: 'list' | 'grid' | 'cards' | 'masonry';
  columns?: number;
  showDescriptions?: boolean;
}

const { title, services, showDescriptions = true } = Astro.props;
const layout =
  Astro.props.layout === 'grid' || Astro.props.layout === 'cards'
    ? Astro.props.layout
    : 'list';
const columns = [2, 3, 4].includes(Number(Astro.props.columns))
  ? Number(Astro.props.columns)
  : 2;

const components = {
  types: {},
  marks: {},
  block: {},
  list: {},
  listItem: {},
};
---

<div
  class:list={['servicesblock', 'page', `layout-${layout}`]}
  style={`--service-cols: ${columns};`}
>
  {title && <h2 class="servicesblock-title">{title}</h2>}

  <div class="servicesblock-items">
    {
      services &&
        services.map((service) => (
          <div class="service-item">
            <h3 class="service-name">{service.title}</h3>
            {showDescriptions && service.content && (
              <div class="service-desc">
                <PortableText value={service.content} components={components} />
              </div>
            )}
          </div>
        ))
    }
  </div>
</div>

<style>
  .servicesblock-title {
    font-size: var(--fs-5);
    line-height: 112.5%;
    margin-bottom: var(--space-xl);
    font-weight: 500;
  }

  .service-name {
    font-size: var(--fs-0);
    font-weight: 500;
    line-height: 112.5%;
    letter-spacing: -0.0125em;
    margin: 0;
  }

  .service-desc {
    font-size: var(--fs--1);
    opacity: 0.7;
    font-weight: 400;
    line-height: 133%;
  }

  :global(.service-desc p) {
    margin: 0;
  }

  :global(.service-desc p + p) {
    margin-top: var(--space-s);
  }

  /* List: title left, text right, subtle top rule */
  .layout-list .servicesblock-items {
    display: flex;
    flex-direction: column;
  }

  .layout-list .service-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xs);
    padding-block: var(--space-m);
    border-top: 1px solid rgb(from var(--black) r g b / 0.1);
  }

  @media (min-width: 768px) {
    .layout-list .service-item {
      grid-template-columns: 1fr 1fr;
      gap: var(--gap-default);
      align-items: start;
    }
  }

  /* Grid: stacked title + text in columns */
  .layout-grid .servicesblock-items {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-default);
  }

  .layout-grid .service-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  @media (min-width: 768px) {
    .layout-grid .servicesblock-items {
      grid-template-columns: repeat(var(--service-cols, 2), minmax(0, 1fr));
    }
  }

  /* Cards: no gutter, shared gridlines */
  .layout-cards .servicesblock-items {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-block-start: 1px solid rgb(from var(--black) r g b / 0.12);
    border-inline-start: 1px solid rgb(from var(--black) r g b / 0.12);
  }

  .layout-cards .service-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-m);
    border-block-end: 1px solid rgb(from var(--black) r g b / 0.12);
    border-inline-end: 1px solid rgb(from var(--black) r g b / 0.12);
  }

  @media (min-width: 768px) {
    .layout-cards .servicesblock-items {
      grid-template-columns: repeat(var(--service-cols, 2), minmax(0, 1fr));
    }
  }
</style>
