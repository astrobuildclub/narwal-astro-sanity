---
import { PortableText } from 'astro-portabletext';

interface Props {
  title: string;
  services: Array<{
    _id: string;
    title: string;
    content?: any[];
  }>;
  layout?: 'list' | 'grid' | 'cards';
  showDescriptions?: boolean;
}

const { title, services, showDescriptions = true } = Astro.props;

const components = {
  types: {},
  marks: {},
  block: {},
  list: {},
  listItem: {},
};
---

<div class:list={['servicesblock', 'page']}>
  {title && <h2 class="servicesblock-title">{title}</h2>}

  <div class="servicesblock-grid">
    {
      services &&
        services.map((service) => (
          <div class="service-item">
            <h3 class="service-name">{service.title}</h3>
            {showDescriptions && service.content && (
              <div class="service-desc">
                <PortableText value={service.content} components={components} />
              </div>
            )}
          </div>
        ))
    }
  </div>
</div>

<style>
  .servicesblock-title {
    font-size: var(--fs-5);
    line-height: 112.5%;
    margin-bottom: var(--space-xl);
    font-weight: 500;
  }

  .servicesblock-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-default);
  }

  @media (min-width: 768px) {
    .servicesblock-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .service-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .service-name {
    font-size: var(--fs-0);
    font-weight: 500;
    line-height: 112.5%;
    letter-spacing: -0.0125em;
    margin: 0;
  }

  .service-desc {
    font-size: var(--fs--1);
    opacity: 0.7;
    font-weight: 400;
    line-height: 133%;
  }

  :global(.service-desc p) {
    margin: 0;
  }

  :global(.service-desc p + p) {
    margin-top: var(--space-s);
  }
</style>
