---
import PersonCard from '../PersonCard.astro';
import type { SanityImage } from '../../sanity/types';

interface role {
  name?: string;
  description?: string;
}
interface member {
  _id?: string;
  title?: string;
  roles?: role[];
  featuredImage?: SanityImage;
}
interface Props {
  title: string;
  members: member[];
}

const { title, members } = Astro.props;
---

<section class:list={['teamblock', 'page']} data-team-reveal>
  {title && <h2 class="teamblock-title">{title}</h2>}
  <div class="teamblock-grid grid gap-[var(--space-xs)] md:grid-cols-3">
    {
      members &&
        members.map((member: member) => (
          <PersonCard
            name={member.title}
            roles={member.roles}
            photo={member.featuredImage}
          />
        ))
    }
  </div>
</section>

<style>
  .teamblock-title {
    font-size: var(--fs-5);
    line-height: 112.5%;
    margin-bottom: var(--space-xl);
    font-weight: 500;
  }

  @media (prefers-reduced-motion: no-preference) {
    .teamblock[data-team-reveal]:not(.is-ready) :global(.person) {
      opacity: 0;
      animation: team-reveal-fallback 0s 1.5s forwards;
    }

    .teamblock[data-team-reveal]:not(.is-ready) :global(.person-photo-img) {
      opacity: 0;
      transform: scale(1.04);
      animation: team-photo-fallback 0s 1.5s forwards;
    }

    .teamblock[data-team-reveal].is-ready :global(.person),
    .teamblock[data-team-reveal].is-ready :global(.person-photo-img) {
      animation: none;
    }
  }

  @keyframes team-reveal-fallback {
    to {
      opacity: 1;
    }
  }

  @keyframes team-photo-fallback {
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import {
    createInViewController,
    prefersReducedMotion,
  } from '../../lib/gsap-inview';

  let ctx: gsap.Context | undefined;
  let initToken = 0;
  const visibility = createInViewController();

  function cleanup() {
    visibility.cleanup();
    ctx?.revert();
    ctx = undefined;
  }

  function initTeamReveal() {
    const token = ++initToken;
    cleanup();

    const blocks = document.querySelectorAll<HTMLElement>(
      '.teamblock[data-team-reveal]',
    );
    if (!blocks.length) return;

    if (prefersReducedMotion()) {
      blocks.forEach((block) => block.classList.add('is-ready'));
      return;
    }

    ctx = gsap.context(() => {
      blocks.forEach((block) => {
        if (!document.contains(block)) return;

        const cards = block.querySelectorAll<HTMLElement>('.person');
        const images = block.querySelectorAll<HTMLElement>('.person-photo-img');
        if (!cards.length) {
          block.classList.add('is-ready');
          return;
        }

        const tl = gsap.timeline({ paused: true });

        gsap.set(cards, { opacity: 0 });
        if (images.length) {
          gsap.set(images, { opacity: 0, scale: 1.04 });
        }

        tl.to(
          cards,
          {
            opacity: 1,
            duration: 2,
            ease: 'sine.out',
            stagger: 0.1,
          },
          0,
        );

        if (images.length) {
          tl.to(
            images,
            {
              opacity: 1,
              scale: 1,
              duration: 0.6,
              ease: 'power2.out',
              stagger: 0.05,
              clearProps: 'transform',
            },
            0,
          );
        }

        const trigger =
          block.querySelector('.teamblock-grid') ?? block;

        block.classList.add('is-ready');

        visibility.playWhenVisible(trigger, () => {
          if (token !== initToken) return;
          tl.play();
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTeamReveal);
  } else {
    initTeamReveal();
  }

  document.addEventListener('astro:page-load', initTeamReveal);
  document.addEventListener('astro:before-swap', () => {
    initToken += 1;
    cleanup();
  });
</script>
