---
import { Image } from 'astro:assets';
import Hero from '../Hero.astro';
import BlockRenderer from '../BlockRenderer.astro';
import ProjectFooter from '../ProjectFooter.astro';
import TagGroup from '../TagGroup.astro';
import { urlForImage } from '../../../sanity/lib/image';

type Props = {
  data: any;
};

const { data } = Astro.props;

const hero = data.hero;
const content = data.content;
const info = data.info;
const credits = data.credits;
const services = data.services;
const industry = data.industry;
const relatedProjects = Array.isArray(data.relatedProjects)
  ? data.relatedProjects.filter(Boolean)
  : [];

const nextProject =
  relatedProjects.length > 0
    ? relatedProjects[Math.floor(Math.random() * relatedProjects.length)]
    : null;

const nextProjectTags = nextProject
  ? [
      ...(nextProject.industry?.title
        ? [
            {
              title: nextProject.industry.title,
              variant: 'filled' as const,
            },
          ]
        : []),
      ...(Array.isArray(nextProject.services)
        ? nextProject.services
            .filter((service: any) => service?.title)
            .map((service: any) => ({
              title: service.title,
              variant: 'outline' as const,
            }))
        : []),
    ]
  : [];

const nextProjectImage = nextProject?.thumbnail?.image?.asset
  ? urlForImage(nextProject.thumbnail.image)?.width(2400).url() || ''
  : '';

const heroData = {
  title: hero?.title || data.title,
  subtitle: hero?.subtitle,
  intro: hero?.intro,
  coverMedia: hero?.coverMedia,
  clients: data.client ? [data.client] : [],
};
---

<Hero data={heroData} />

{
  content && content.length > 0 && (
    <article
      class="project full"
      data-reveal-children=".page-layout > *"
      data-reveal-step="38"
      style="--reveal-duration: 560ms; --reveal-distance: 20px;"
    >
      <BlockRenderer prefix="ProjectContent" blocks={content} />
    </article>
  )
}

{
  (info || industry || services || credits) && (
    <ProjectFooter
      info={info}
      industry={industry}
      services={services}
      credits={credits}
    />
  )
}

{
  nextProject && (
    <a href={`/project/${nextProject.slug}/`} class="next-project full">
      <div class="next-project-copy">
        <p class="next-project-label">Next Project</p>
        <h2 class="next-project-title">
          {nextProject.title}
        </h2>
        {nextProject.hero?.intro && (
          <p class="next-project-intro">{nextProject.hero.intro}</p>
        )}
        {nextProjectTags.length > 0 && <TagGroup tags={nextProjectTags} />}
      </div>
      {nextProjectImage && (
        <div class="next-project-media">
          <Image
            src={nextProjectImage}
            alt={nextProject.title || ''}
            width={2400}
            height={1350}
            widths={[800, 1200, 1800, 2400]}
            sizes="100vw"
            format="avif"
            class="next-project-img"
          />
        </div>
      )}
    </a>
  )
}

<style>
  .project {
    /* Padding now handled by page-layout grid via --site-padding */
  }

  .next-project {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    padding-top: var(--space-3xl);
  }

  .next-project-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-s);
    padding-inline: var(--site-padding);
    padding-bottom: var(--space-xl);
  }

  .next-project-label {
    margin: 0;
    font-size: var(--fs--1);
    font-weight: 500;
    opacity: 0.5;
  }

  .next-project-title {
    margin: 0;
    font-size: var(--fs-6);
    font-weight: 500;
    line-height: 100%;
    letter-spacing: -0.03em;
  }

  .next-project-intro {
    margin: 0;
    max-width: 52ch;
    font-size: var(--fs--1);
    line-height: 140%;
  }

  .next-project-media {
    overflow: hidden;
    height: min(42vh, 22rem);
  }

  .next-project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }
</style>
